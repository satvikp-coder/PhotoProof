# Copy to .env (Git-ignored). Only these variables are recognized; any other
# PHOTOPROOF_* variable is rejected as a configuration error.

# Overrides settings.yaml environment.mode: development | testing | production
# PHOTOPROOF_ENVIRONMENT=development

# Overrides settings.yaml logging.level: DEBUG | INFO | WARNING | ERROR
# PHOTOPROOF_LOG_LEVEL=INFO

# Launcher only: print the environment report on every start
# PHOTOPROOF_LAUNCHER_VERBOSE=1
