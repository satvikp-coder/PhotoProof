{
    "$schema":  "https://opencode.ai/config.json",
    "permission":  {
                       "edit":  "allow",
                       "bash":  {
                                    "*":  "ask",
                                    "git status *":  "allow",
                                    "git diff *":  "allow",
                                    "git log *":  "allow",
                                    "git remote -v":  "allow",
                                    "git remote get-url *":  "allow",
                                    "git rev-parse *":  "allow",
                                    "gh auth status *":  "allow",
                                    "gh repo view *":  "allow",
                                    "gh issue list *":  "allow",
                                    "gh issue view *":  "allow",
                                    "gh pr list *":  "allow",
                                    "gh pr view *":  "allow",
                                    "gh pr checks *":  "allow",
                                    "git add *":  "ask",
                                    "git commit *":  "ask",
                                    "git push *":  "ask",
                                    "git pull *":  "ask",
                                    "git merge *":  "ask",
                                    "git rebase *":  "ask",
                                    "git reset *":  "ask",
                                    "git clean *":  "ask",
                                    "gh issue create *":  "ask",
                                    "gh issue edit *":  "ask",
                                    "gh issue close *":  "ask",
                                    "gh pr create *":  "ask",
                                    "gh pr edit *":  "ask",
                                    "gh pr ready *":  "ask",
                                    "gh pr close *":  "ask",
                                    "gh pr merge *":  "ask"
                                }
                   }
}
